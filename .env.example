# Allow public IPv4/IPv6 clients by default. HTTP/WS is unencrypted without TLS.
SPACECHAT_PORT=18081
SPACECHAT_VERSION=0.4.0
SPACECHAT_MINIMUM_VERSION=0.0.0
SPACECHAT_ALLOW_CIDR=0.0.0.0/0,::/0
# Empty: derive the client address from the installer request's IP/host and port.
# Set ws://YOUR_SERVER_IP:18081/ws to pin an IP, or wss://chat.example.com/ws for TLS.
# Required when a reverse proxy terminates TLS.
SPACECHAT_PUBLIC_URL=
# This default seed is PUBLIC. Use your own private seed before public deployment.
SPACECHAT_SIGNING_KEY_FILE=./deploy/docker/default-update-signing.seed
# Public CA certificates only; never point this at a TLS private key.
SPACECHAT_CLIENT_CA_FILE=./deploy/docker/empty-client-ca.pem
# Both tls.crt and tls.key enable TLS; just one file causes startup to fail.
SPACECHAT_TLS_DIR=./deploy/docker/tls
# Registry and namespace, without a URL scheme or trailing slash.
# Use docker.io/library to use Docker Hub and the host's registry-mirrors config.
# Another official image source: public.ecr.aws/docker/library
SPACECHAT_BASE_IMAGE_PREFIX=docker.m.daocloud.io/library
# Build-time module proxy; artifacts still compile offline at runtime.
GOPROXY=https://goproxy.cn,direct
# Debian mirror origin, without a trailing slash; archive signature checks stay enabled.
DEBIAN_MIRROR=https://mirrors.aliyun.com
# Download mirror for the exact pinned Windows Terminal ZIP; SHA-256 stays fixed.
# For direct downloads, use the corresponding https://github.com/ release URL.
WINDOWS_TERMINAL_URL=https://files.m.daocloud.io/github.com/microsoft/terminal/releases/download/v1.24.11911.0/Microsoft.WindowsTerminal_1.24.11911.0_x64.zip
