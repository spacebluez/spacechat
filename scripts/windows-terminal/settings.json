{
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "defaultProfile": "{3f80440e-28d7-4f36-9c2a-39d845951770}",
  "firstWindowPreference": "defaultProfile",
  "windowingBehavior": "useNew",
  "theme": "dark",
