[Unit]
Description=Clear all XChat encrypted rooms and messages
After=xchat-rooms.service

[Service]
Type=oneshot
User=xchat-rooms
Group=xchat-rooms
ExecStart=/usr/bin/python3 /opt/xchat-rooms/clear_history.py --yes --socket /run/xchat-rooms/admin.sock
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0077
