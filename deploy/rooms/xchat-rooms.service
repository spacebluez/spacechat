[Unit]
Description=XChat encrypted rooms server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xchat-rooms
Group=xchat-rooms
WorkingDirectory=/var/lib/xchat-rooms
EnvironmentFile=/etc/xchat-rooms/server.env
RuntimeDirectory=xchat-rooms
RuntimeDirectoryMode=0700
ExecStart=/opt/xchat-rooms/xchat-server -listen ${XCHAT_LISTEN} -db /var/lib/xchat-rooms/rooms.db -allow-cidr ${XCHAT_ALLOW_CIDR} -encryption-key-file /etc/xchat-rooms/encryption.key -admin-socket /run/xchat-rooms/admin.sock -tls-cert ${XCHAT_TLS_CERT} -tls-key ${XCHAT_TLS_KEY} -kaomoji ${XCHAT_KAOMOJI} -update-dir /opt/xchat-rooms/updates -installer-dir /opt/xchat-rooms/installers -update-public-key-file /etc/xchat-rooms/update-public.key
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/xchat-rooms

[Install]
WantedBy=multi-user.target
